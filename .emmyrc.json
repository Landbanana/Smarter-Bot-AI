{
  "$schema": "https://raw.githubusercontent.com/EmmyLuaLs/emmylua-analyzer-rust/refs/heads/main/crates/emmylua_code_analysis/resources/schema.json",
  "codeAction": {
    "insertSpace": true
  },
  "codeLens": {
    "enable": true
  },
  "completion": {
    "autoRequire": true,
    "autoRequireFunction": "require",
    "autoRequireNamingConvention": "keep",
    "autoRequireSeparator": ".",
    "baseFunctionIncludesName": true,
    "callSnippet": true,
    "enable": true,
    "postfix": "@"
  },
  "diagnostics": {
    "diagnosticInterval": 500,
    "disable": [
      "need-check-nil",
      "duplicate-set-field",
      "unnecessary-if"
    ],
    "enable": true,
    "enables": [],
    "globals": [],
    "globalsRegex": []
  },
  "doc": {
    "syntax": "none"
  },
  "documentColor": {
    "enable": true
  },
  "hint": {
    "enable": true,
    "enumParamHint": true,
    "indexHint": true,
    "localHint": true,
    "metaCallHint": true,
    "overrideHint": true,
    "paramHint": true
  },
  "hover": {
    "customDetail": 50,
    "enable": true
  },
  "inlineValues": {
    "enable": true
  },
  "references": {
    "enable": true,
    "fuzzySearch": true,
    "shortStringSearch": false
  },
  "reformat": {
    "externalTool": null,
    "externalToolRangeFormat": null,
    "useDiff": false
  },
  "resource": {
    "paths": []
  },
  "runtime": {
    "classDefaultCall": {
      "forceNonColon": false,
      "forceReturnSelf": true,
      "functionName": "__new"
    },
    "extensions": [
      ".lua"
    ],
    "frameworkVersions": [],
    "nonstandardSymbol": [],
    "requireLikeFunction": [
      "require_raw",
      "requireSpecific"
    ],
    "requirePattern": [
      "?.lua"
    ],
    "version": "Lua5.2"
  },
  "semanticTokens": {
    "enable": true
  },
  "signature": {
    "detailSignatureHelper": true
  },
  "strict": {
    "arrayIndex": true,
    "docBaseConstMatchBaseType": true,
    "metaOverrideFileDefine": false,
    "requireExportGlobal": false,
    "requirePath": true,
    "typeCall": true
  },
  "workspace": {
    "enableReindex": true,
    "encoding": "utf-8",
    "ignoreDir": [
      "_OLD",
      "Yuri_test"
    ],
    "ignoreGlobs": [],
    "library": [
      "C:/Users/dstag/Desktop/Programs/VSCode Libraries/Barotrauma/Library/Client"
    ],
    "moduleMap": [],
    "preloadFileSize": 0,
    "reindexDuration": 10000,
    "workspaceRoots": [
      "Lua"
    ]
  }
}